# Environment Configuration
# Copy this file to .env and fill in the values

# ============================================
# LLM Configuration
# ============================================
# Options: huggingface | openai | ollama | anthropic
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# --- Hugging Face Example ---
# LLM_PROVIDER=huggingface
# LLM_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
# (or Qwen/Qwen2.5-72B-Instruct, mistralai/Mistral-7B-Instruct-v0.3, deepseek-ai/DeepSeek-R1-Distill-Qwen-32B)
# LLM_BASE_URL=https://router.huggingface.co/hf-inference/v1
# LLM_API_KEY=hf_your_token_here
# (or HF_TOKEN=hf_your_token_here)

# --- OpenAI Example ---
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...

# ============================================
# Embedding Configuration
# ============================================
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434
# For OpenAI: EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workflow_architect
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=workflow_architect
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ============================================
# Qdrant Configuration
# ============================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=company_knowledge

# ============================================
# Backend Configuration
# ============================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DEBUG=true
BACKEND_LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-random-secret-key

# ============================================
# Frontend Configuration
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_PORT=3000

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================
# Execution Limits
# ============================================
MAX_WORKFLOW_STEPS=50
MAX_EXECUTION_TIME_SECONDS=300
MAX_RETRIES_PER_STEP=3
MAX_TOOL_CALLS_PER_EXECUTION=100
MAX_CONCURRENT_EXECUTIONS=10
MAX_REQUIREMENT_LENGTH=5000

# ============================================
# Deployment Configuration (Vercel + Render)
# ============================================
# When deploying to Render, set these in the Render Dashboard:
#   - DATABASE_URL is auto-set by Render PostgreSQL addon
#   - LLM_API_KEY must be set manually
#   - CORS_ORIGINS must include your Vercel frontend URL
#   - SECRET_KEY is auto-generated by render.yaml
#
# When deploying frontend to Vercel, set:
#   - NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
